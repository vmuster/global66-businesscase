# ═══════════════════════════════════════════════════════════════════════════════
#  Global66 VoC Intelligence — variables de entorno
#
#  Copia este archivo a `.env` (Windows: `copy .env.example .env`) y edita los
#  3 a 5 valores que correspondan a tu tier. El `.env` real está en .gitignore
#  y nunca se commitea.
#
#  Hay 3 PRESETS pre-armados abajo: free, paid balanceado, paid agresivo.
#  Elige UNO, descomenta las líneas correspondientes y pega tu API key.
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. ELIGE TU PROVEEDOR (cualquiera funciona; mantenemos cadena de failover)
# ───────────────────────────────────────────────────────────────────────────
# Si dejas `LLM_PROVIDERS` con la cadena completa, el sistema intenta:
# Gemini → si agota cuota → OpenAI → si agota → Anthropic. Necesitas al
# menos UNA key cargada para que arranque.
LLM_PROVIDERS=gemini,openai,anthropic


# ── 2. PEGA TU(S) API KEY(S)
# ───────────────────────────────────────────────────────────────────────────
# Google Gemini   → https://aistudio.google.com/  (recomendado)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI          → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Anthropic       → https://console.anthropic.com/  ($5 USD trial)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5


# ─────────────────────────────────────────────────────────────────────────────
#  3. PRESETS DE RATE LIMITING — elige UNO según tu situación
# ─────────────────────────────────────────────────────────────────────────────
#
# 🟢 PRESET A — FREE TIER (default activado abajo)
#    Sin tarjeta de crédito. Cuota Gemini free (15 RPM, ~1000 RPD) cubre
#    una corrida completa del dataset (250 cases) con margen.
#    ⏱️ Tiempo batch: ~30 min   💰 Costo: $0   📊 Concurrencia: 1
#
# 🔵 PRESET B — PAID BALANCEADO
#    Ideal para iteración. Activa billing en aistudio.google.com (Google regala
#    $300 USD de crédito gratis la primera vez). Cap real Gemini paid: 4000 RPM.
#    Usamos 30 RPM para dejar 99% de margen.
#    ⏱️ Tiempo batch: ~5-8 min  💰 Costo: ~$0.08   📊 Concurrencia: 2
#
# 🔴 PRESET C — PAID AGRESIVO
#    Demos en vivo y benchmarks. Procesa los 250 cases en 2-3 minutos.
#    ⏱️ Tiempo batch: ~3 min   💰 Costo: ~$0.08   📊 Concurrencia: 8
#
# Para cambiar de preset: comenta el bloque actual y descomenta el deseado.

# 🟢 PRESET A — FREE TIER (activado por default)
GEMINI_RATE_LIMIT_RPM=8
OPENAI_RATE_LIMIT_RPM=3
ANTHROPIC_RATE_LIMIT_RPM=4
BATCH_CONCURRENCY=1
MAX_BATCH_COST_USD=0.50

# 🔵 PRESET B — PAID BALANCEADO
# GEMINI_RATE_LIMIT_RPM=30
# OPENAI_RATE_LIMIT_RPM=60
# ANTHROPIC_RATE_LIMIT_RPM=20
# BATCH_CONCURRENCY=2
# MAX_BATCH_COST_USD=1.00

# 🔴 PRESET C — PAID AGRESIVO
# GEMINI_RATE_LIMIT_RPM=200
# OPENAI_RATE_LIMIT_RPM=200
# ANTHROPIC_RATE_LIMIT_RPM=50
# BATCH_CONCURRENCY=8
# MAX_BATCH_COST_USD=1.00


# ─────────────────────────────────────────────────────────────────────────────
#  Privacidad
# ─────────────────────────────────────────────────────────────────────────────
# Sal HMAC-SHA256 para pseudonimizar `user_id` antes de log o DB.
# CAMBIAR EN PRODUCCIÓN (cualquier string aleatorio largo sirve).
PSEUDONYM_SALT=change-me-please-this-is-not-secure


# ─────────────────────────────────────────────────────────────────────────────
#  Persistencia
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/voc.db


# ─────────────────────────────────────────────────────────────────────────────
#  Scoring
# ─────────────────────────────────────────────────────────────────────────────
SCORING_CONFIG=config/scoring.yaml


# ─────────────────────────────────────────────────────────────────────────────
#  Batch histórico — timestamps sintéticos
#  El dataset entregado en el PDF NO trae timestamps. Sintetizamos con seed
#  reproducible para habilitar SLA y series temporales sin inventar comportamiento.
#  Declarado explícitamente en el dashboard y en el One-Pager.
# ─────────────────────────────────────────────────────────────────────────────
SYNTHETIC_TIMESTAMP_WINDOW_DAYS=14
SYNTHETIC_TIMESTAMP_SEED=42


# ─────────────────────────────────────────────────────────────────────────────
#  Modo verbose para terceros (dejarlo apagado en producción)
# ─────────────────────────────────────────────────────────────────────────────
# Si quieres ver los banners de deprecación de google-generativeai y otros, pon 1.
# VOC_VERBOSE_THIRDPARTY=1


# ═══════════════════════════════════════════════════════════════════════════════
#  Modo legacy single-provider (back-compat). Solo se usa si LLM_PROVIDERS
#  está vacío. Si ambos están vacíos, auto-detecta por keys presentes.
# ═══════════════════════════════════════════════════════════════════════════════
# LLM_PROVIDER=gemini
# LLM_RATE_LIMIT_RPM=8
